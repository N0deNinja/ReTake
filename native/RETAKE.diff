+    static TasMotion& tas_motion() { static auto* value = new TasMotion; return *value; }
+    static void tas_line_off(TasMotion& m) {
+        std::string owner;
+        {
+            std::lock_guard lock(m.waiting_mutex);
+            owner = m.line_owner;
+        }
+        input::step_script().stop(owner);
+        m.line.store(TasMotion::Line::off, std::memory_order_release);
+    }
+    // What a line does this step: its asks first, then the phase it is in. It never holds the skater: a stop
+    // is the game's slow motion, and a run up is a locked playing.
+    static void tas_line_step(TasMotion& m, std::size_t since) {
+        using Line = TasMotion::Line;
+        using Ask = TasMotion::LineAsk;
+        auto& script = input::step_script();
+        switch (m.line_ask.exchange(Ask::none, std::memory_order_acq_rel)) {
+        case Ask::start: {
+            std::string owner;
+            unsigned controller{};
+            {
+                std::lock_guard lock(m.waiting_mutex);
+                owner = m.line_owner;
+                controller = m.line_controller;
+            }
+            if (script.record_line(owner, controller, input::StepScript::max_steps).empty() && script.hold()) {
+                std::lock_guard lock(m.frames_mutex);
+                m.frames.clear();
+                m.frames.reserve(input::StepScript::max_steps);
+                m.locked = false;
+                m.line_rebuilt = false;
+                m.line_waited = 0;
+                m.line.store(Line::seeking, std::memory_order_release);
+            }
+            break;
+        }
+        case Ask::stop:
+            tas_line_off(m);
+            break;
+        case Ask::halt:
+            script.halt();
+            if (m.line.load(std::memory_order_acquire) != Line::off) m.line.store(Line::played, std::memory_order_release);
+            break;
+        case Ask::seek:
+            if (m.line.load(std::memory_order_acquire) != Line::off && script.hold()) {
+                m.line_rebuilt = false;
+                m.line_waited = 0;
+                m.line.store(Line::seeking, std::memory_order_release);
+            }
+            break;
+        case Ask::none:
+            break;
+        }
+        const auto status = script.status();
+        switch (m.line.load(std::memory_order_acquire)) {
+        case Line::off:
+        case Line::played:
+            break;
+        case Line::live:
+            // Full, or the input went (the game's menu): it stops there, and the line stays to go back in.
+            if (status.mode == input::StepScript::Mode::off) m.line.store(Line::played, std::memory_order_release);
+            break;
+        case Line::seeking:
+            ++m.line_waited;
+            if ((m.line_rebuilt && since >= TasMotion::line_settle_steps) || m.line_waited > TasMotion::line_give_up_steps)
+                m.line.store(Line::counting, std::memory_order_release);
+            break;
+        case Line::counting:
