+            tas_motion().capture_wanted.store(true, std::memory_order_release);
+        }
+    }
+    static void tas_begin_playing(std::string_view owner, unsigned controller, int lead, TasRestore restore, std::string& why) {
+        why = input::step_script().play(owner, controller, lead);
+        if (why.empty()) {
+            tas_motion().locked = restore == TasRestore::lock;
+            // A locked playing puts back its first step itself, with all the others.
+            if (restore != TasRestore::lock) tas_motion().restore_wanted.store(static_cast<int>(restore), std::memory_order_release);
+        }
+    }
+    // A rewind drops what it goes back over, so asking again goes further back. A step that can't be read
+    // ends the history: an old snapshot is never put back across a gap.
+    static void tas_step_history(TasMotion& m, const NoBailSkater& skater, std::size_t since) noexcept {
+        if (!m.history_on.load(std::memory_order_acquire)) return;
+        const auto size = TasMotion::history_steps;
+        if (m.rewind_waiting.load(std::memory_order_acquire)) {
+            ++m.rewind_waited;
+            if (m.rewind_rebuilt && since >= TasMotion::rewind_settle_steps) {
+                if (motion_snapshot::restore(skater, m.history[m.rewind_at], true)) m.rewinds.fetch_add(1, std::memory_order_relaxed);
+                m.rewind_waiting.store(false, std::memory_order_release);
+            } else if (m.rewind_waited > TasMotion::rewind_give_up_steps) {
+                m.rewind_waiting.store(false, std::memory_order_release); // the teleport never came: carry on from here
+            }
+            return; // nothing from a skater on its way back is kept
+        }
+        if (const auto wanted = m.rewind_wanted.exchange(0, std::memory_order_acq_rel); wanted > 0 && m.history_count > 0) {
+            // history_next - 1 is the newest; going back `wanted` steps, at most to the oldest.
+            const auto back = std::min<std::size_t>(static_cast<std::size_t>(wanted), m.history_count - 1);
+            m.rewind_at = (m.history_next + size - 1 - back) % size;
+            m.history_next = (m.rewind_at + 1) % size;
+            m.history_count -= back;
+            m.history_length.store(m.history_count, std::memory_order_release);
+            m.rewind_rebuilt = false;
+            m.rewind_waited = 0;
+            m.rewind_waiting.store(true, std::memory_order_release);
+            return;
+        }
+        if (!motion_snapshot::capture(skater, m.history[m.history_next])) {
+            m.history_count = 0;
+            m.history_length.store(0, std::memory_order_release);
+            return;
+        }
+        m.history_next = (m.history_next + 1) % size;
+        m.history_count = std::min(m.history_count + 1, size);
+        m.history_length.store(m.history_count, std::memory_order_release);
+    }
+    static void tas_on_step(const NoBailSkater& skater, float, bool) noexcept {
+        virtual_time::on_step();
+        auto& m = tas_motion();
+        std::uint32_t built{};
+        const std::size_t since = memory::peek(skater.core + addr::skater_state::core_steps_since_built, built) ? built : 0;
+        // A skater built anew (a respawn, a teleport): what was taken before refers to objects now gone.
+        if (since + 1 < m.since_spawn.load(std::memory_order_relaxed)) {
+            if (m.rewind_waiting.load(std::memory_order_acquire)) m.rewind_rebuilt = true;
+            m.line_rebuilt = true;
+        }
+        m.since_spawn.store(since, std::memory_order_release);
+        try {
+            std::lock_guard lock(m.waiting_mutex);
+            if (m.waiting && since == m.waiting->at) {
+                std::string why;
+                if (m.waiting->recording) tas_begin_recording(m.waiting->owner, m.waiting->controller, m.waiting->steps, why);
+                else tas_begin_playing(m.waiting->owner, m.waiting->controller, m.waiting->lead, m.waiting->restore, why);
+                m.waiting.reset();
+            }
+        } catch (...) {
+        }
+        if (m.capture_wanted.exchange(false, std::memory_order_acq_rel)) {
+            m.captured.store(motion_snapshot::capture(skater, m.snapshot), std::memory_order_release);
+            // A recording goes through the restore its replays will: what the sync rounds, it rounds here too.
+            if (m.captured.load(std::memory_order_acquire)) (void)motion_snapshot::restore(skater, m.snapshot, false);
+        }
+        if (const auto wanted = m.restore_wanted.exchange(0, std::memory_order_acq_rel))
+            if (motion_snapshot::restore(skater, m.snapshot, wanted == static_cast<int>(TasRestore::all)))
+                m.restores.fetch_add(1, std::memory_order_relaxed);
+        if (const auto wanted = m.save_wanted.exchange(0, std::memory_order_acq_rel)) {
+            const auto slot = static_cast<std::size_t>(wanted - 1);
+            const bool taken = motion_snapshot::capture(skater, m.saved[slot]);
+            m.saved_valid[slot].store(taken, std::memory_order_release);
+            if (taken) m.saves.fetch_add(1, std::memory_order_relaxed);
+        }
+        if (const auto wanted = m.load_wanted.exchange(0, std::memory_order_acq_rel)) {
+            const auto slot = static_cast<std::size_t>(wanted - 1);
+            if (motion_snapshot::restore(skater, m.saved[slot], m.load_skeleton.load(std::memory_order_acquire)))
+                m.loads.fetch_add(1, std::memory_order_relaxed);
+        }
+        tas_step_history(m, skater, since);
+        motion_snapshot::match_flight_step(skater, skater_physics::step_length());
+        try {
+            if (m.line.load(std::memory_order_acquire) != TasMotion::Line::off && multiplayer_session_active()) tas_line_off(m); // never a held skater in a session
+            if (m.line.load(std::memory_order_acquire) != TasMotion::Line::off || m.line_ask.load(std::memory_order_acquire) != TasMotion::LineAsk::none)
+                tas_line_step(m, since);
+            // Taken and put back at the same point of the step, so step N of a playing starts as it did.
+            const auto script = input::step_script().status();
+            // A line records by game time: in slow motion a frame only every so many steps, so a replay at full
+            // speed goes through what happened meanwhile at the speed the rest of it goes.
+            if (m.line.load(std::memory_order_acquire) == TasMotion::Line::live && script.mode == input::StepScript::Mode::recording && !script.holding) {
+                constexpr float frame = 1.0f / 60.0f;
+                // (No skater to read it from: every step is a frame, as at full speed.)
+                const float length = skater_physics::step_length();
+                m.line_time += length > 0 ? length : frame;
+                if (m.line_time < frame * 0.99f) return;
+                m.line_time = std::max(0.0f, m.line_time - frame);
+            }
+            if (script.mode == input::StepScript::Mode::recording && !script.holding) {
+                // A run up that handed over: what came after that step is gone.
+                if (m.frames.size() > script.length) {
+                    std::lock_guard lock(m.frames_mutex);
+                    m.frames.resize(script.length);
+                }
+                m.frames.emplace_back();
+                (void)motion_snapshot::capture(skater, m.frames.back());
+            } else if (script.mode == input::StepScript::Mode::playing && m.locked && script.step < m.frames.size()) {
+                if (motion_snapshot::restore(skater, m.frames[script.step], true)) m.restores.fetch_add(1, std::memory_order_relaxed);
+            }
+            input::step_script().step();
+            const auto s = input::step_script().status();
+            m.line_length.store(s.length, std::memory_order_release);
+            m.line_step.store(s.step, std::memory_order_release);
+            if (s.mode != input::StepScript::Mode::off && !s.holding) state_dump::on_step(skater, s.step);
+        } catch (...) {
+        }
+    }
+    std::string tas_dump(std::uint32_t every) override {
+        if (auto why = tas_refusal(true); !why.empty()) return why;
+        state_dump::arm(every);
+        return {};
+    }
+    // `name` is checked by the API: letters, digits, '-', '_' and '.', and no leading dot.
+    std::string tas_dump_save(std::string_view name) override {
+        return state_dump::save(game_folder() / L"logs" / L"tas_state" / std::filesystem::path(std::string(name) + ".tasd"));
+    }
+    static std::string tas_refusal(bool allowed) {
+        static std::atomic<bool> listening{};
+        if (multiplayer_session_active()) return "never in a multiplayer session";
+        if (!allowed) return "the game does not have gameplay input";
+        if (!listening.load(std::memory_order_acquire)) {
+            if (!add_no_bail_step_listener(&tas_on_step)) return "the skater's physics steps are unavailable";
+            listening.store(true, std::memory_order_release);
+        }
+        return {};
+    }
+    // Waits for its step since the spawn, or says it has gone by; the caller asks again after a new spawn.
+    static std::string tas_wait(TasMotion::Waiting waiting) {
+        auto& m = tas_motion();
+        if (m.since_spawn.load(std::memory_order_acquire) >= waiting.at) return "that step since the spawn has gone by";
+        std::lock_guard lock(m.waiting_mutex);
+        m.waiting = std::move(waiting);
+        return {};
+    }
+    std::string tas_record(std::string_view plugin, unsigned controller, std::size_t steps, std::size_t at) override {
+        if (auto why = tas_refusal(input_allowed()); !why.empty()) return why;
+        if (at) return tas_wait({true, std::string(plugin), controller, steps, at, 0, TasRestore::none});
+        std::string why;
+        tas_begin_recording(plugin, controller, steps, why);
+        return why;
+    }
+    std::string tas_play(std::string_view plugin, unsigned controller, int lead, TasRestore restore, std::size_t at) override {
+        if (auto why = tas_refusal(input_allowed()); !why.empty()) return why;
+        if (restore != TasRestore::none && !tas_motion().captured.load(std::memory_order_acquire))
+            return "the motion was not taken when the script was recorded";
+        if (at) return tas_wait({false, std::string(plugin), controller, 0, at, lead, restore});
+        std::string why;
+        tas_begin_playing(plugin, controller, lead, restore, why);
+        return why;
+    }
+    void tas_stop(std::string_view plugin) override {
+        {
+            std::lock_guard lock(tas_motion().waiting_mutex);
+            if (tas_motion().waiting && tas_motion().waiting->owner == plugin) tas_motion().waiting.reset();
+            if (tas_motion().line_owner == plugin) {
+                tas_motion().line.store(TasMotion::Line::off, std::memory_order_release);
+                tas_motion().line_ask.store(TasMotion::LineAsk::none, std::memory_order_release);
+            }
+        }
+        input::step_script().stop(plugin);
+        input::step_script().set_paused(false);
+        (void)tas_clock(1.0f);
+        (void)tas_no_bail(false);
+    }
+    std::string tas_line_start(std::string_view plugin, unsigned controller, std::size_t at) override {
+        if (auto why = tas_refusal(true); !why.empty()) return why;
+        auto& m = tas_motion();
+        {
+            std::lock_guard lock(m.waiting_mutex);
+            m.waiting.reset();
+            m.line_owner = std::string(plugin);
+            m.line_controller = controller;
+        }
+        m.line_from.store(0, std::memory_order_release);
+        m.line_to.store(0, std::memory_order_release);
+        m.line_at.store(at, std::memory_order_release);
+        m.line_hand_over.store(true, std::memory_order_release);
+        m.line_ask.store(TasMotion::LineAsk::start, std::memory_order_release);
+        return {};
+    }
+    std::string tas_line_seek(std::size_t from, std::size_t to, std::size_t at, bool hand_over) override {
+        if (auto why = tas_refusal(true); !why.empty()) return why;
+        auto& m = tas_motion();
+        if (to > m.line_length.load(std::memory_order_acquire) || from > to) return "that is not a part of the line";
+        m.line_from.store(from, std::memory_order_release);
+        m.line_to.store(to, std::memory_order_release);
+        m.line_at.store(at, std::memory_order_release);
+        m.line_hand_over.store(hand_over, std::memory_order_release);
+        m.line_ask.store(TasMotion::LineAsk::seek, std::memory_order_release);
+        return {};
+    }
+    std::string tas_line_go() override {
+        if (auto why = tas_refusal(true); !why.empty()) return why;
+        input::step_script().go();
+        return {};
+    }
+    std::string tas_line_stop() override {
+        tas_motion().line_ask.store(TasMotion::LineAsk::stop, std::memory_order_release);
+        return {};
+    }
+    std::string tas_line_halt() override {
+        tas_motion().line_ask.store(TasMotion::LineAsk::halt, std::memory_order_release);
+        return {};
+    }
+    // The game's clock alone: slower for a wait, faster to catch up. The simulation's rate stays, so the step a
+    // skater takes does not change: its flight through the air is a path read once a step, and a shorter step
+    // through the same path flings it (15.6 to 201 m/s, 2026-11-06). Fewer steps come each real second, and the
+    // game's update with them: at 0.05, three a second. Faster, the steps a second have to be let through too.
+    std::optional<std::array<std::string, 2>> tas_clock_found_;
+    static constexpr const char* tas_clock_scale = "SimulationTime.TimeScale";
+    static constexpr const char* tas_clock_fps = "SimulationTime.MaxSimFps";
+    std::string tas_clock(float scale) override {
+        if (scale == 1.0f) {
+            if (tas_clock_found_) {
+                (void)change_named_setting(tas_clock_scale, (*tas_clock_found_)[0], false);
+                (void)change_named_setting(tas_clock_fps, (*tas_clock_found_)[1], false);
+                tas_clock_found_.reset();
+            }
+            return {};
+        }
+        if (multiplayer_session_active()) return "never in a multiplayer session";
+        if (!tas_clock_found_) {
+            auto found_scale = named_setting_value(tas_clock_scale);
+            auto found_fps = named_setting_value(tas_clock_fps);
+            if (!found_scale || !found_fps) return "the game's clock is not ready";
+            tas_clock_found_ = std::array<std::string, 2>{std::move(*found_scale), std::move(*found_fps)};
+        }
+        const auto rate = simulation_time::rate_of(skater_physics::step_length());
+        const auto fps = scale > 1.0f ? std::to_string(std::lround(static_cast<float>(rate ? rate : 60u) * scale)) : (*tas_clock_found_)[1];
+        std::array<char, 32> text{};
+        const auto written = std::to_chars(text.data(), text.data() + text.size(), scale);
+        if (written.ec != std::errc{}) return "that clock speed cannot be written";
+        // Up: the steps let through first. Down: the same, as the old limit does no harm for the moment it lasts.
+        if (const auto why = change_named_setting(tas_clock_fps, fps, false); why.starts_with("error: ")) return why;
+        if (const auto why = change_named_setting(tas_clock_scale, std::string_view(text.data(), static_cast<std::size_t>(written.ptr - text.data())), false); why.starts_with("error: ")) return why;
+        return {};
+    }
+    // The game's wipeouts off, the switch a player has in the menu and the console (nobail). Given back with the plugin.
+    bool tas_no_bail_held_{};
+    std::string tas_no_bail(bool on) override {
+        if (on && multiplayer_session_active()) return "never in a multiplayer session";
+        if (on == tas_no_bail_held_) return {};
+        auto why = queue(overlay::DebugAction::set_no_bail, on);
+        if (why.empty()) tas_no_bail_held_ = on;
+        return why;
+    }
+    std::string tas_line_paused(bool paused) override {
+        if (auto why = tas_refusal(true); !why.empty() && paused) return why;
+        input::step_script().set_paused(paused);
+        return {};
+    }
+    std::string tas_line_hold() override {
+        if (auto why = tas_refusal(true); !why.empty()) return why;
+        input::step_script().hold_input();
+        return {};
+    }
+    TasLine tas_line() override {
+        using Line = TasMotion::Line;
+        auto& m = tas_motion();
+        if (tas_clock_found_ && multiplayer_session_active()) (void)tas_clock(1.0f);
+        const char* phase = "off";
+        switch (m.line.load(std::memory_order_acquire)) {
+        case Line::off: break;
+        case Line::live: phase = "live"; break;
+        case Line::seeking: phase = "seeking"; break;
+        case Line::counting: phase = "counting"; break;
+        case Line::running_up: phase = "running_up"; break;
+        case Line::played: phase = "played"; break;
+        }
+        return {phase, m.line_length.load(std::memory_order_acquire), m.line_step.load(std::memory_order_acquire), m.since_spawn.load(std::memory_order_acquire)};
+    }
+    std::optional<std::array<float, 3>> tas_line_position(std::size_t step) override {
+        auto& m = tas_motion();
+        std::lock_guard lock(m.frames_mutex);
+        if (step >= m.line_length.load(std::memory_order_acquire) || step >= m.frames.size() || !m.frames[step].valid) return std::nullopt;
+        const auto& t = m.frames[step].board[0].transform;
+        return std::array<float, 3>{t[12], t[13], t[14]};
+    }
+    // A bug report: its text, then every step of the line. The controller is as recorded, in XInput's raw units
+    // (buttons as bits, triggers 0 to 255, sticks -32768 to 32767), and the board is where the line had it.
+    static constexpr std::size_t line_save_most_bytes = 8u << 20;
+    std::string tas_line_save(std::string_view plugin, std::string_view path, std::string_view text) override {
+        const auto inputs = input::step_script().recorded();
+        std::vector<std::array<float, 3>> boards;
+        std::vector<char> valid;
+        {
+            auto& m = tas_motion();
+            std::lock_guard lock(m.frames_mutex);
+            const auto length = std::min(m.frames.size(), m.line_length.load(std::memory_order_acquire) + 1);
+            boards.reserve(length);
+            valid.reserve(length);
+            for (std::size_t i = 0; i < length; ++i) {
+                const auto& t = m.frames[i].board[0].transform;
+                boards.push_back({t[12], t[13], t[14]});
+                valid.push_back(m.frames[i].valid ? 1 : 0);
+            }
+        }
+        const auto rows = std::max(inputs.size(), boards.size());
+        std::string out;
+        out.reserve(text.size() + 200 + rows * 72);
+        out.append(text);
+        out += std::format("\n== The line, every step: the controller as recorded and where the board was ({} inputs, {} board steps) ==\n",
+                           inputs.size(), boards.size());
+        out += "step\tbuttons\tlt\trt\tlx\tly\trx\try\tboard_x\tboard_y\tboard_z\n";
+        for (std::size_t i = 0; i < rows; ++i) {
+            if (i < inputs.size()) {
+                const auto& p = inputs[i];
+                out += std::format("{}\t{:04x}\t{}\t{}\t{}\t{}\t{}\t{}", i, p.buttons, p.left_trigger, p.right_trigger, p.left_x, p.left_y, p.right_x, p.right_y);
+            } else {
+                out += std::format("{}\t\t\t\t\t\t\t", i);
+            }
+            if (i < boards.size() && valid[i]) out += std::format("\t{:.3f}\t{:.3f}\t{:.3f}\n", boards[i][0], boards[i][1], boards[i][2]);
+            else out += "\t\t\t\n";
+        }
+        out += "== end of the line ==\n";
+        return files_write_bytes(plugin, path, out, line_save_most_bytes);
+    }
+    std::optional<TasBodies> tas_line_bodies(std::size_t step) override {
+        auto& m = tas_motion();
+        std::lock_guard lock(m.frames_mutex);
+        if (step >= m.line_length.load(std::memory_order_acquire) || step >= m.frames.size() || !m.frames[step].valid) return std::nullopt;
+        const auto& frame = m.frames[step];
+        TasBodies bodies;
+        std::copy(frame.board[0].transform.begin(), frame.board[0].transform.end(), bodies.board.begin());
+        for (std::size_t i = 0; i < bodies.skeleton.size(); ++i) {
+            const auto& t = frame.skeleton[i].transform;
+            bodies.skeleton[i] = {t[12], t[13], t[14]};
+        }
+        return bodies;
+    }
+    TasStatus tas_status() override {
+        if (virtual_time::active() && multiplayer_session_active()) (void)virtual_time::set(false);
+        (void)tas_refusal(true); // the count since the spawn needs the listener from the first ask
