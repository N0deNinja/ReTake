+            }
+            break;
+        case Line::running_up:
+            if (status.mode == input::StepScript::Mode::recording) m.line.store(Line::live, std::memory_order_release);
+            else if (status.mode == input::StepScript::Mode::off) m.line.store(Line::played, std::memory_order_release);
+            break;
+        }
+    }
+    static void tas_begin_recording(std::string_view owner, unsigned controller, std::size_t steps, std::string& why) {
+        why = input::step_script().record(owner, controller, steps);
+        if (why.empty()) {
