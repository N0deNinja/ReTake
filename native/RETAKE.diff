diff --git a/Extension/Skater/state_dump.cpp b/Extension/Skater/state_dump.cpp
new file mode 100644
index 0000000..f76bca2
--- /dev/null
+++ b/Extension/Skater/state_dump.cpp
@@ -0,0 +1,111 @@
+#include "state_dump.h"
+#include "Engine/Core/Platform/memory.h"
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/skater_body.h"
+#include "Engine/Game/Build/20260929/skater_movement.h"
+#include "Engine/Game/Build/20260929/skater_state.h"
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <vector>
+
+namespace dingosdk::state_dump {
+namespace {
+namespace body = addr::skater_body;
+namespace state = addr::skater_state;
+namespace movement = addr::skater_movement;
+
+constexpr std::size_t chunk = 0x100;
+
+struct Dump {
+    std::mutex mutex;
+    std::vector<unsigned char> bytes;
+    std::atomic<bool> armed{};
+    std::uint32_t every{};
+};
+Dump& dump() {
+    static auto* value = new Dump;
+    return *value;
+}
+template <class T> void append(std::vector<unsigned char>& out, const T& value) {
+    const auto* raw = reinterpret_cast<const unsigned char*>(&value);
+    out.insert(out.end(), raw, raw + sizeof(T));
+}
+// Unreadable chunks stay 0xCD: a block's size is a generous guess at the object's, and may run past it.
+void add_block(std::vector<unsigned char>& out, std::uint32_t step, std::uint32_t id, std::uintptr_t address, std::uint32_t size) {
+    if (address < 0x10000) return;
+    append(out, step);
+    append(out, id);
+    append(out, static_cast<std::uint64_t>(address));
+    append(out, size);
+    const auto at = out.size();
+    out.resize(at + size, 0xCD);
+    for (std::size_t done = 0; done < size; done += chunk) {
+        const auto length = std::min<std::size_t>(chunk, size - done);
+        (void)memory::peek_bytes(address + done, out.data() + at + done, length);
+    }
+}
+std::uintptr_t pointer_at(std::uintptr_t address) noexcept {
+    std::uintptr_t value{};
+    return memory::peek(address, value) ? value : 0;
+}
+}
+
+void arm(std::uint32_t every) {
+    auto& d = dump();
+    std::lock_guard lock(d.mutex);
+    d.bytes.clear();
+    d.bytes.reserve(16u << 20);
+    const char magic[4] = {'T', 'A', 'S', 'D'};
+    d.bytes.insert(d.bytes.end(), magic, magic + 4);
+    d.every = every;
+    d.armed.store(true, std::memory_order_release);
+}
+
+void on_step(const NoBailSkater& skater, std::size_t step) noexcept {
+    auto& d = dump();
+    if (!d.armed.load(std::memory_order_acquire)) return;
+    try {
+        std::lock_guard lock(d.mutex);
+        if (!wanted(step, d.every) || d.bytes.size() >= max_bytes) return;
+        auto& out = d.bytes;
+        const auto number = static_cast<std::uint32_t>(step);
+        // The ids stay as they are: the comparing script names them.
+        add_block(out, number, 0, skater.context, 0x2000);
+        add_block(out, number, 1, skater.core, 0x4200);
+        add_block(out, number, 2, skater.rig, 0x4700);
+        add_block(out, number, 3, pointer_at(skater.core + state::trick_state_offset), 0x800);
+        add_block(out, number, 4, pointer_at(skater.core + movement::skater_parent), 0x400);
+        const auto board_holder = pointer_at(skater.core + state::board_holder_offset);
+        add_block(out, number, 5, board_holder, 0x400);
+        const auto board_physics = pointer_at(board_holder + state::board_physics_offset);
+        add_block(out, number, 6, board_physics, 0x100);
+        add_block(out, number, 7, pointer_at(board_physics + state::physics_bodies_offset),
+            state::board_body_count * static_cast<std::uint32_t>(state::physics_body_size) + 0x20);
+        const auto rig_physics = pointer_at(skater.rig + state::rig_physics_offset);
+        add_block(out, number, 8, rig_physics, 0x2000);
+        add_block(out, number, 9, pointer_at(rig_physics + state::physics_bodies_offset),
+            state::rig_body_count * static_cast<std::uint32_t>(state::physics_body_size) + 0x20);
+        add_block(out, number, 10, pointer_at(rig_physics + body::contact_struct_offset), 0x2000);
+        add_block(out, number, 11, pointer_at(skater.core + body::core_step_input_offset), 0x100);
+        add_block(out, number, 12, skater.entity, 0x800);
+    } catch (...) {
+    }
+}
+
+std::string save(const std::filesystem::path& file) {
+    auto& d = dump();
+    d.armed.store(false, std::memory_order_release);
+    std::lock_guard lock(d.mutex);
+    if (d.bytes.size() <= 4) return "nothing was taken";
+    std::error_code error;
+    std::filesystem::create_directories(file.parent_path(), error);
+    if (error) return "the folder could not be made: " + error.message();
+    std::ofstream stream(file, std::ios::binary | std::ios::trunc);
+    stream.write(reinterpret_cast<const char*>(d.bytes.data()), static_cast<std::streamsize>(d.bytes.size()));
+    d.bytes.clear();
+    return stream.good() ? std::string{} : std::string("the file could not be written");
+}
+}
diff --git a/Extension/Skater/state_dump.h b/Extension/Skater/state_dump.h
new file mode 100644
index 0000000..fc9f615
--- /dev/null
+++ b/Extension/Skater/state_dump.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "Extension/Skater/no_bail.h"
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+
+// Research: the local skater's raw memory at chosen physics steps of a run, saved to a file for
+// comparing runs. It finds what a restore must also put back for a run to repeat exactly. It only reads.
+//
+// The file is the magic "TASD", then records: u32 step, u32 block id, u64 address, u32 size, the bytes.
+// Bytes that could not be read are left as 0xCD. Blocks are ids into state_dump::block_names.
+namespace dingosdk::state_dump {
+inline constexpr std::size_t max_bytes = 64u << 20;
+// Client thread: the next run's steps are taken: the first few, then every `every` steps.
+void arm(std::uint32_t every);
+// Physics thread, in a step (a no_bail step listener): `step` counts from the run's start.
+void on_step(const NoBailSkater& skater, std::size_t step) noexcept;
+// Client thread: ends the taking and writes what was taken. Empty when it worked, else why not.
+std::string save(const std::filesystem::path& file);
+// Whether `step` of a run is one taken, by the rule arm() describes.
+constexpr bool wanted(std::size_t step, std::uint32_t every) noexcept {
+    return step <= 5 || (every != 0 && step % every == 0);
+}
+}
diff --git a/Extension/Skater/virtual_time.cpp b/Extension/Skater/virtual_time.cpp
new file mode 100644
index 0000000..def3025
--- /dev/null
+++ b/Extension/Skater/virtual_time.cpp
@@ -0,0 +1,114 @@
+#include "virtual_time.h"
+#include "Engine/Core/Hooks/hooks.h"
+#include "Engine/Core/Log/logging.h"
+#include <Windows.h>
+#include <atomic>
+#include <mutex>
+
+namespace dingosdk::virtual_time {
+namespace {
+using QueryCounter = BOOLEAN(NTAPI*)(LARGE_INTEGER*);
+
+struct Clock {
+    QueryCounter real{};
+    std::atomic<bool> on{};
+    std::atomic<std::int64_t> now{};          // what is read while on
+    std::atomic<std::int64_t> offset{};       // real minus what is read, while off
+    std::atomic<std::int64_t> last_advance{}; // the real clock when `now` last moved
+    std::atomic<std::uint64_t> reads{};
+    std::int64_t step{}, frequency{}, stall{};
+    bool hooked{};
+    std::mutex mutex;
+};
+Clock& clock() {
+    static auto* value = new Clock;
+    return *value;
+}
+std::int64_t read_real() noexcept {
+    LARGE_INTEGER value{};
+    clock().real(&value);
+    return value.QuadPart;
+}
+// Any thread, as often as the game likes: no locks.
+BOOLEAN NTAPI counter_hook(LARGE_INTEGER* out) {
+    auto& c = clock();
+    const auto result = c.real(out);
+    if (!result || !out) return result;
+    c.reads.fetch_add(1, std::memory_order_relaxed);
+    const auto real = out->QuadPart;
+    if (!c.on.load(std::memory_order_acquire)) {
+        out->QuadPart = real - c.offset.load(std::memory_order_relaxed);
+        return result;
+    }
+    // No step for a while: a load or a pause. One thread at a time moves time on, by whole steps.
+    auto last = c.last_advance.load(std::memory_order_relaxed);
+    if (real - last > c.stall && c.last_advance.compare_exchange_strong(last, real, std::memory_order_acq_rel))
+        c.now.fetch_add(c.step, std::memory_order_acq_rel);
+    out->QuadPart = c.now.load(std::memory_order_acquire);
+    return result;
+}
+bool install() noexcept {
+    auto& c = clock();
+    if (c.hooked) return true;
+    LARGE_INTEGER frequency{};
+    if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0) return false;
+    const auto ntdll = GetModuleHandleW(L"ntdll.dll");
+    const auto target = ntdll ? reinterpret_cast<void*>(GetProcAddress(ntdll, "RtlQueryPerformanceCounter")) : nullptr;
+    if (!target) return false;
+    c.frequency = frequency.QuadPart;
+    c.step = ticks_per_step(frequency.QuadPart);
+    c.stall = frequency.QuadPart / 10; // a tenth of a second with no step
+    void* original{};
+    {
+        HookBatch batch;
+        if (hook_prepare(target, reinterpret_cast<void*>(&counter_hook), &original) != HookOk) return false;
+        c.real = reinterpret_cast<QueryCounter>(original);
+        if (hook_enable(target) != HookOk) return false;
+    }
+    c.hooked = true;
+    logging::write(logging::Level::info, logging::Channel::skater, "Virtual time: the performance counter is hooked.");
+    return true;
+}
+}
+
+bool set(bool on) noexcept {
+    auto& c = clock();
+    try {
+        std::lock_guard lock(c.mutex);
+        if (!install()) return false;
+        if (on == c.on.load(std::memory_order_acquire)) return true;
+        const auto real = read_real();
+        if (on) {
+            c.now.store(real - c.offset.load(std::memory_order_relaxed), std::memory_order_release);
+            c.last_advance.store(real, std::memory_order_release);
+        } else {
+            c.offset.store(real - c.now.load(std::memory_order_acquire), std::memory_order_release);
+        }
+        c.on.store(on, std::memory_order_release);
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+bool active() noexcept { return clock().on.load(std::memory_order_acquire); }
+
+void on_step() noexcept {
+    auto& c = clock();
+    if (!c.on.load(std::memory_order_acquire)) return;
+    c.now.fetch_add(c.step, std::memory_order_acq_rel);
+    // Held to real time, in the odd case the game is running ahead of it. Never for long.
+    const auto last = c.last_advance.load(std::memory_order_acquire);
+    const auto due = last + c.step;
+    auto real = read_real();
+    const auto give_up = real + c.step * 2;
+    while (real < due && real < give_up) {
+        if (due - real > c.frequency / 500) Sleep(1);
+        else YieldProcessor();
+        real = read_real();
+    }
+    c.last_advance.store(real, std::memory_order_release);
+}
+
+std::uint64_t reads() noexcept { return clock().reads.load(std::memory_order_relaxed); }
+}
diff --git a/Extension/Skater/virtual_time.h b/Extension/Skater/virtual_time.h
new file mode 100644
index 0000000..edd549c
--- /dev/null
+++ b/Extension/Skater/virtual_time.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <cstdint>
+
+// Research: the process's performance counter driven by the skater's physics steps. While on, the time
+// any thread reads moves only when a physics step runs, by the same amount each step, so what the game
+// works out from the clock between steps (a frame's length, for filters and animation) is the same in every
+// run. Each step is held back to real time, so the game runs at its usual speed. If no step comes (a load,
+// a pause), time creeps on from the real clock, so nothing waiting on it waits for ever.
+namespace dingosdk::virtual_time {
+// Pure: the counter ticks a step moves time by. A step of the game's fixed 60 a second, rounded up and one
+// more, so that a frame's time never falls short of its step.
+constexpr std::int64_t ticks_per_step(std::int64_t frequency) noexcept {
+    return (frequency + 59) / 60 + 1;
+}
+// Client thread. The hook goes in at the first use and stays; off, it gives the real clock on from where
+// the virtual one reached, so time never runs backwards. False when the hook could not go in.
+bool set(bool on) noexcept;
+bool active() noexcept;
+// Physics thread, once a step.
+void on_step() noexcept;
+// Reads of the clock answered since the game started, whether on or off: 0 means the hook sees nothing.
+std::uint64_t reads() noexcept;
+}
