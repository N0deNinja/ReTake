+    // A dump reads thousands of blocks and writes 8 MB: far past a plugin call's 50 ms, so it runs on a thread of its
+    // own, one at a time, and the plugin asks how it went (tas_skater_dump_status).
+    struct SkaterDump {
+        std::mutex mutex;
+        bool running{};
+        std::string outcome; // "saved", or why not; empty before the first
+    };
+    static SkaterDump& skater_dump_state() {
+        static auto* value = new SkaterDump; // a thread may still be writing at exit
+        return *value;
+    }
+    std::string tas_skater_dump(std::string_view plugin, std::string_view path) override {
+        if (multiplayer_session_active()) return "never in a multiplayer session";
+        NoBailSkater skater;
+        if (!no_bail_skater(skater)) return "there is no skater to read";
+        std::filesystem::path root, file;
+        if (auto why = data_file(plugin, path, root, file); !why.empty()) return why;
+        auto& state = skater_dump_state();
+        {
+            std::lock_guard lock(state.mutex);
+            if (state.running) return "a skater dump is still being written";
+            state.running = true;
+            state.outcome.clear();
+        }
+        std::thread([skater, file] {
+            std::string outcome = "saved";
+            try {
+                const auto bytes = state_dump::graph(skater, line_save_most_bytes);
+                std::error_code error;
+                std::filesystem::create_directories(file.parent_path(), error);
+                std::ofstream out(file, std::ios::binary | std::ios::trunc);
+                if (error || !out || !out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()))) outcome = "the file cannot be written";
+            } catch (...) {
+                outcome = "the skater could not be read";
+            }
+            auto& done = skater_dump_state();
+            std::lock_guard lock(done.mutex);
+            done.outcome = std::move(outcome);
+            done.running = false;
+        }).detach();
+        return {};
+    }
+    std::string tas_skater_dump_status() override {
+        auto& state = skater_dump_state();
+        std::lock_guard lock(state.mutex);
+        return state.running ? std::string("writing") : state.outcome;
+    }
+    // A line saved to a file and loaded back (line_file.h). A minute of line is about 11 MB of motion before it is
+    // compressed: far past a plugin call's 50 ms, so both run on a thread of their own, one at a time, and the plugin
+    // asks how it went (tas_line_file_status).
+    struct LineFile {
+        std::mutex mutex;
+        bool running{};
+        std::string doing;   // "saving" or "loading"
+        std::string outcome; // "saved", "loaded", or why not; empty before the first
+    };
+    static LineFile& line_file_state() {
+        static auto* value = new LineFile; // a thread may still be writing at exit
+        return *value;
+    }
+    static constexpr std::uint64_t line_file_most_bytes = 512ull << 20;
+    static bool line_file_begin(const char* doing) {
+        auto& state = line_file_state();
+        std::lock_guard lock(state.mutex);
+        if (state.running) return false;
+        state.running = true;
+        state.doing = doing;
+        state.outcome.clear();
+        return true;
+    }
+    static void line_file_end(std::string outcome) {
+        auto& state = line_file_state();
+        std::lock_guard lock(state.mutex);
+        state.outcome = std::move(outcome);
+        state.running = false;
+    }
+    // A line file's header and its note (line_file.h); empty when it is one this build can load, else why not.
+    static std::string read_line_head(std::ifstream& in, std::uint64_t size, line_file::Header& header, std::string& note) {
+        if (size > line_file_most_bytes || size < sizeof(header) || !in.read(reinterpret_cast<char*>(&header), sizeof(header)))
+            return "it is not a ReTake line";
+        std::uint32_t note_size = 0;
+        if (header.version >= 2) {
+            if (!in.read(reinterpret_cast<char*>(&note_size), sizeof(note_size)) || note_size > line_file::most_note) return "it is not a ReTake line";
+            note.assign(note_size, '\0');
+            if (note_size && !in.read(note.data(), note_size)) return "the file is cut short";
+        }
+        return line_file::check<motion_snapshot::Snapshot>(header, static_cast<std::size_t>(size), input::StepScript::max_steps, note_size);
+    }
+    std::optional<std::string> tas_line_note(std::string_view plugin, std::string_view path, std::string& why) override {
+        std::filesystem::path root, file;
+        if (why = data_file(plugin, path, root, file); !why.empty()) return std::nullopt;
+        std::error_code error;
+        const auto size = std::filesystem::file_size(file, error);
+        std::ifstream in(file, std::ios::binary);
+        if (error || !in) {
+            why = "there is no such line";
+            return std::nullopt;
+        }
+        line_file::Header header{};
+        std::string note;
+        if (why = read_line_head(in, size, header, note); !why.empty()) return std::nullopt;
+        return note;
+    }
+    std::string tas_line_export(std::string_view plugin, std::string_view path, std::string_view note_text) override {
+        if (note_text.size() > line_file::most_note) return "the note is too long";
+        auto& m = tas_motion();
+        auto inputs = input::step_script().recorded();
+        if (inputs.empty()) return "no line is recorded";
+        std::filesystem::path root, file;
+        if (auto why = data_file(plugin, path, root, file); !why.empty()) return why;
+        std::vector<motion_snapshot::Snapshot> frames;
+        {
+            std::lock_guard lock(m.frames_mutex);
+            frames.assign(m.frames.begin(), m.frames.begin() + static_cast<std::ptrdiff_t>(std::min(m.frames.size(), inputs.size())));
+        }
+        if (!line_file_begin("saving")) return "a line is being saved or loaded";
+        std::thread([inputs = std::move(inputs), frames = std::move(frames), file, note = std::string(note_text)] {
+            std::string outcome = "saved";
+            try {
+                const auto raw = line_file::pack(inputs, frames);
+                std::string packed(ZSTD_compressBound(raw.size()), '\0');
+                const std::size_t packed_size = ZSTD_compress(packed.data(), packed.size(), raw.data(), raw.size(), 3);
+                if (ZSTD_isError(packed_size)) {
+                    outcome = "the line could not be compressed";
+                } else {
+                    const auto header = line_file::header_for<motion_snapshot::Snapshot>(inputs.size(), frames.size(), raw.size(), packed_size);
+                    std::error_code error;
+                    std::filesystem::create_directories(file.parent_path(), error);
+                    auto temporary = file;
+                    temporary += ".tmp";
+                    {
+                        std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+                        const auto note_size = static_cast<std::uint32_t>(note.size());
+                        if (!out || !out.write(reinterpret_cast<const char*>(&header), sizeof(header)) ||
+                            !out.write(reinterpret_cast<const char*>(&note_size), sizeof(note_size)) ||
+                            (note_size && !out.write(note.data(), note_size)) ||
+                            !out.write(packed.data(), static_cast<std::streamsize>(packed_size)))
+                            outcome = "the file cannot be written";
+                    }
+                    if (outcome == "saved") {
+                        std::filesystem::rename(temporary, file, error);
+                        if (error) outcome = "the file cannot be written";
+                    }
+                    if (outcome != "saved") std::filesystem::remove(temporary, error);
+                }
+            } catch (...) {
+                outcome = "the line could not be saved";
+            }
+            line_file_end(std::move(outcome));
+        }).detach();
+        return {};
+    }
+    std::string tas_line_import(std::string_view plugin, std::string_view path, unsigned controller) override {
