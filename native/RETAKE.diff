+        std::array<std::atomic<bool>, slots> saved_valid{};
+        std::atomic<int> save_wanted{};  // a slot + 1
+        std::atomic<int> load_wanted{};  // a slot + 1
+        std::atomic<bool> load_skeleton{};
+        std::atomic<std::size_t> saves{}, loads{};
