+        const bool read = memory::peek(skater.context + state::context_sensor_on_a, a) && memory::peek(skater.context + state::context_sensor_on_b, b);
+        m.sensor.store(!read ? -1 : (a == 1.0f && b == 1.0f) ? 1 : 0, std::memory_order_release);
+    }
